    {
      "target": "lnkdx",
      "public": "sites/lnkdx",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "headers": [
        {
          "source": "**/*.@(html|js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=300,must-revalidate"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/park-availability",
          "function": {
            "functionId": "lnkdxParkAvailability",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/park-checkout",
          "function": {
            "functionId": "lnkdxCreateCheckout",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/park-finalize",
          "function": {
            "functionId": "lnkdxFinalizeCheckout",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/stripe-webhook",
          "function": {
            "functionId": "lnkdxStripeWebhook",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/resolve",
          "function": {
            "functionId": "lnkdxResolve",
            "region": "us-central1"
          }
        },
