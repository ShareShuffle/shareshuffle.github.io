            {
              "key": "Cache-Control",
              "value": "public,max-age=300,must-revalidate"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/index.html",
          "destination": "/",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/invite",
          "destination": "/invite/index.html"
        },
        {
          "source": "/invite/**",
          "destination": "/invite/index.html"
        },
        {
          "source": "/api/account/**",
          "function": {
            "functionId": "tempoAccountApi",
            "region": "us-central1"
          }
        }
      ]
