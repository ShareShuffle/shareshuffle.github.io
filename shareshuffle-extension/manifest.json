{
  "manifest_version": 3,
  "name": "ShareShuffle",
  "version": "0.0.1",
  "description": "Save and share product recommendations with personal notes.",

"permissions": ["activeTab", "tabs", "clipboardWrite", "scripting", "storage"],

"host_permissions": [
  "https://firestore.googleapis.com/*"
],  
"icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ShareShuffle",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}