{
  "manifest_version": 3,
  "name": "ShareShuffle",
  "version": "0.1.1",
  "description": "Save product recommendations to shareable shelves. Links may include affiliate links, including Amazon and Walmart.",
  "permissions": [
    "activeTab",
    "tabs",
    "clipboardWrite",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://firestore.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "action": {
    "default_title": "ShareShuffle",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png",
      "256": "icons/icon256.png",
      "512": "icons/icon512.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
