{
  "name": "ShareShuffle",
  "short_name": "Shuffle",
  "description": "ShareShuffle turns messy product links into clean, personal recommendations.",
  "start_url": "/app/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#EEF6FF",
  "theme_color": "#EEF6FF",
  "icons": [
    {
      "src": "/icons/favicon-96x96.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "/icons/icon192-square.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon512-square.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}