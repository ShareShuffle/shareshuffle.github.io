{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "solution-workshop-b77a6",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/p", "destination": "/privacy/", "type": 301 },
      { "source": "/t", "destination": "/terms/", "type": 301 },
      { "source": "/privacy", "destination": "/privacy/", "type": 301 },
      { "source": "/terms", "destination": "/terms/", "type": 301 }
    ],
    "rewrites": [
      { "source": "/api/shorten", "function": "shortener" },
      { "source": "/:slug*", "function": "shortener" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
