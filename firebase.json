{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "**/*.zip",
      "**/*.psd",
      "**/__MACOSX/**",
      "**/.DS_Store",
      ".firebase/**",
      "firebase-debug.log"
    ],
    "rewrites": [
      {
        "source": "/getPreview",
        "function": "getPreview"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ]
}
