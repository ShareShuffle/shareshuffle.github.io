rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isString(field, maxLength) {
      return field is string && field.size() <= maxLength;
    }

    function hasKey(data, key) {
      return data.keys().hasAny([key]);
    }

    function optionalString(data, key, maxLength) {
      return !hasKey(data, key) || isString(data[key], maxLength);
    }

    function optionalBool(data, key) {
      return !hasKey(data, key) || data[key] is bool;
    }

    function optionalNumber(data, key) {
      return !hasKey(data, key) || data[key] is number;
    }

    match /supportMessages/{messageId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          "name",
          "email",
          "category",
          "subject",
          "message",
          "pageUrl",
          "userAgent",
          "createdAt"
        ])
        && isString(request.resource.data.name, 120)
        && isString(request.resource.data.email, 254)
        && request.resource.data.email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")
        && isString(request.resource.data.category, 80)
        && isString(request.resource.data.subject, 160)
        && isString(request.resource.data.message, 3000)
        && isString(request.resource.data.pageUrl, 500)
        && isString(request.resource.data.userAgent, 500)
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    match /waitlist/{leadId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          "email",
          "firstName",
          "source",
          "interestType",
          "favoriteRecommendation",
          "createdAt",
          "pageUrl"
        ])
        && isString(request.resource.data.email, 254)
        && request.resource.data.email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")
        && isString(request.resource.data.firstName, 100)
        && isString(request.resource.data.source, 50)
        && isString(request.resource.data.interestType, 100)
        && isString(request.resource.data.favoriteRecommendation, 500)
        && isString(request.resource.data.pageUrl, 500)
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    match /shares/{shareId} {
      allow read: if true;

      // TEMP COMPATIBILITY RULE:
      // Allows both the submitted Chrome Store extension's old share payload
      // and the newer router payload with handleSlug/handleDisplay/publicPath.
      // New route fields are allowed, but not required yet.
      allow create: if
        request.resource.data.keys().hasOnly([
          "title",
          "url",
          "originalUrl",
          "merchant",
          "affiliateApplied",
          "note",
          "image",
          "created",
          "views",
          "amazonClicks",
          "shares",
          "shelfName",
          "shelfSlug",
          "handleSlug",
          "handleDisplay",
          "publicPath",
          "cardPath",
          "imagePath",
          "shortUrl",
          "cardUrl",
          "imageUrl",
          "imageStatus",
          "imageSource",
          "updatedAt"
        ])
        && isString(request.resource.data.title, 300)
        && isString(request.resource.data.url, 3000)
        && optionalString(request.resource.data, "originalUrl", 3000)
        && optionalString(request.resource.data, "merchant", 50)
        && optionalBool(request.resource.data, "affiliateApplied")
        && optionalString(request.resource.data, "note", 1000)
        && optionalString(request.resource.data, "image", 2000)
        && optionalString(request.resource.data, "shelfName", 100)
        && optionalString(request.resource.data, "shelfSlug", 100)
        && optionalString(request.resource.data, "handleSlug", 60)
        && optionalString(request.resource.data, "handleDisplay", 100)
        && optionalString(request.resource.data, "publicPath", 300)
        && optionalString(request.resource.data, "cardPath", 300)
        && optionalString(request.resource.data, "imagePath", 300)
        && optionalString(request.resource.data, "shortUrl", 300)
        && optionalString(request.resource.data, "cardUrl", 300)
        && optionalString(request.resource.data, "imageUrl", 300)
        && optionalString(request.resource.data, "imageStatus", 40)
        && optionalString(request.resource.data, "imageSource", 40)
        && (!hasKey(request.resource.data, "updatedAt") || request.resource.data.updatedAt == request.time)
        && request.resource.data.created == request.time
        && request.resource.data.views == 0
        && request.resource.data.amazonClicks == 0
        && request.resource.data.shares == 0;

      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "views",
          "amazonClicks",
          "shares",
          "image",
          "cachedImagePath",
          "cachedImageContentType",
          "cachedImageUrl",
          "imageStatus",
          "imageSource",
          "imageUpdatedAt",
          "updatedAt"
        ])
        && optionalNumber(request.resource.data, "views")
        && optionalNumber(request.resource.data, "amazonClicks")
        && optionalNumber(request.resource.data, "shares")
        && optionalString(request.resource.data, "image", 2000)
        && optionalString(request.resource.data, "cachedImagePath", 500)
        && optionalString(request.resource.data, "cachedImageContentType", 80)
        && optionalString(request.resource.data, "cachedImageUrl", 1000)
        && optionalString(request.resource.data, "imageStatus", 40)
        && optionalString(request.resource.data, "imageSource", 40)
        && (!hasKey(request.resource.data, "imageUpdatedAt") || request.resource.data.imageUpdatedAt is timestamp)
        && (!hasKey(request.resource.data, "updatedAt") || request.resource.data.updatedAt is timestamp)
        && request.resource.data.views >= resource.data.views
        && request.resource.data.amazonClicks >= resource.data.amazonClicks
        && request.resource.data.shares >= resource.data.shares;

      allow delete: if false;
    }

    match /shelves/{shelfId} {
      allow read: if true;

      // TEMP COMPATIBILITY RULE:
      // Allows old shelves created by the pending Chrome Store extension
      // plus new router-aware shelf docs. New route fields are optional for now.
      allow create: if
        request.resource.data.keys().hasOnly([
          "name",
          "slug",
          "handleSlug",
          "handleDisplay",
          "routePath",
          "description",
          "image",
          "coverImage",
          "ownerUuid",
          "ownerId",
          "created"
        ])
        && isString(request.resource.data.name, 120)
        && isString(request.resource.data.slug, 120)
        && optionalString(request.resource.data, "handleSlug", 60)
        && optionalString(request.resource.data, "handleDisplay", 100)
        && optionalString(request.resource.data, "routePath", 300)
        && optionalString(request.resource.data, "description", 1000)
        && optionalString(request.resource.data, "image", 2000)
        && optionalString(request.resource.data, "coverImage", 2000)
        && optionalString(request.resource.data, "ownerUuid", 200)
        && optionalString(request.resource.data, "ownerId", 200)
        && request.resource.data.created == request.time;

      allow update: if false;
      allow delete: if false;
    }
  }
}
